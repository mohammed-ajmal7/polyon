# POLYON local/server configuration
POLYON_DATA_DIR=.polyon-data
POLYON_ACTOR_ID=local-user
POLYON_RUNTIME_AUTOSTART=true
POLYON_JOB_RUNTIME_AUTOSTART=true
POLYON_EXECUTION_ENABLED=false
POLYON_APPROVAL_MODE=ASK_EVERYTHING

# Usage/cost governor. Use "zero" to reject paid/unknown-cost model calls.
POLYON_COST_MODE=configured
# JSON array of provider budgets; leave blank for no configured request/token limits.
# Example: [{"providerId":"ollama","dailyRequestLimit":100,"maxTokensPerRun":20000,"maxAgentsPerRun":4,"maxDebateRounds":4}]
POLYON_USAGE_BUDGETS_JSON=

# Optional model execution
# Legacy single-model configuration
POLYON_MODEL_ENDPOINT=
POLYON_MODEL_ID=
POLYON_MODEL_API_KEY=
# Set to true when the model supports tool calling. Direct and Broadcast execution route
# through governed tool orchestration and require a tool-calling model.
POLYON_MODEL_SUPPORTS_TOOLS=
# Maximum simultaneous requests POLYON sends to each model provider. Local runtimes such as
# Ollama serve few requests at once; match OLLAMA_NUM_PARALLEL (often 1-4). Empty = unbounded.
POLYON_MODEL_MAX_CONCURRENCY=
# Optional reasoning_effort for reasoning models (none, low, medium, high). Small local
# reasoning models can spend their whole context on reasoning; "none" returns answers directly.
POLYON_MODEL_REASONING_EFFORT=
POLYON_PROVIDER_ID=configured-model-provider
POLYON_AGENT_ID=primary
POLYON_AGENT_NAME=Primary
POLYON_COLLECTIVE_PRESET=default

# Optional multi-agent model roster. When set, this takes precedence over the legacy model fields.
# API keys are referenced by environment-variable name; secrets are never stored in this JSON.
# Built-in providers may omit endpoint; POLYON supplies the provider default.
# Custom providers must provide endpoint explicitly.
# Example local:
# POLYON_MODEL_PROFILES_JSON=[{"agentId":"researcher","agentName":"Researcher","agentRole":"Research specialist","modelId":"qwen3:8b","providerId":"ollama"}]
# Example hosted:
# POLYON_MODEL_PROFILES_JSON=[{"agentId":"analyst","modelId":"gemini-3.8-flash","providerId":"gemini","apiKeyEnv":"GEMINI_API_KEY"}]

GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional Google Drive / Telegram integrations
# Tokens are server-side only; never expose them to the browser.
POLYON_GOOGLE_DRIVE_ACCESS_TOKEN=
POLYON_GMAIL_ACCESS_TOKEN=
POLYON_TELEGRAM_BOT_TOKEN=
# Required for inbound Telegram webhooks. Set the same value when calling Telegram setWebhook.
POLYON_TELEGRAM_WEBHOOK_SECRET=
# Required allowlist of private Telegram chat IDs, comma-separated.
POLYON_TELEGRAM_ALLOWED_CHAT_IDS=

# Optional SMTP
POLYON_SMTP_HOST=
POLYON_SMTP_PORT=465
POLYON_SMTP_USERNAME=
POLYON_SMTP_PASSWORD=
POLYON_SMTP_SECURE=true
POLYON_SMTP_STARTTLS=false
POLYON_SMTP_HELO_NAME=polyon.local
POLYON_SMTP_MESSAGE_ID_DOMAIN=polyon.local

# Optional encrypted secret store (takes precedence over SMTP_PASSWORD)
POLYON_SECRET_STORE_PATH=.polyon-data/secrets.json
POLYON_SECRET_MASTER_KEY_BASE64=

# Optional embedding provider (OpenAI-compatible)
POLYON_EMBEDDING_ENDPOINT=
POLYON_EMBEDDING_MODEL_ID=
POLYON_EMBEDDING_API_KEY=
POLYON_EMBEDDING_PROVIDER_ID=configured-embedding-provider
POLYON_EMBEDDING_PROVIDER_NAME="Configured embedding provider"
POLYON_EMBEDDING_MODEL_NAME=
POLYON_SEMANTIC_INDEXING_AUTOSTART=true
# Explicit scopes required for automatic embedding; leave blank to disable outbound memory indexing
POLYON_SEMANTIC_INDEX_ALLOWED_SCOPES=

# Optional research search provider
POLYON_RESEARCH_SEARCH_ENDPOINT=
POLYON_RESEARCH_ALLOWED_HOSTS=

# Optional A2A 1.0 push notification webhook allowlist. Empty disables push notifications.
# Public destinations must be HTTPS; local loopback HTTP is allowed by the runtime boundary.
POLYON_A2A_PUSH_ALLOWED_ORIGINS=

# Optional private-server authentication
POLYON_API_TOKEN=

# Optional creative providers (each endpoint must be HTTPS; configure only what you use)
POLYON_CREATIVE_IMAGE_ENDPOINT=
POLYON_CREATIVE_VIDEO_ENDPOINT=
POLYON_CREATIVE_AUDIO_ENDPOINT=
POLYON_CREATIVE_VOICE_ENDPOINT=
POLYON_CREATIVE_EDIT_ENDPOINT=
