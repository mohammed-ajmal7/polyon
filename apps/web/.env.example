# POLYON local/server configuration
POLYON_DATA_DIR=.polyon-data
POLYON_ACTOR_ID=local-user
POLYON_RUNTIME_AUTOSTART=true
POLYON_EXECUTION_ENABLED=false
POLYON_APPROVAL_MODE=ASK_EVERYTHING

# Optional model execution
POLYON_MODEL_ENDPOINT=
POLYON_MODEL_ID=
POLYON_MODEL_API_KEY=
POLYON_PROVIDER_ID=configured-model-provider
POLYON_AGENT_ID=primary
POLYON_AGENT_NAME=Primary

# Optional SMTP
POLYON_SMTP_HOST=
POLYON_SMTP_PORT=465
POLYON_SMTP_USERNAME=
POLYON_SMTP_PASSWORD=
POLYON_SMTP_SECURE=true
POLYON_SMTP_STARTTLS=false
POLYON_SMTP_HELO_NAME=polyon.local
POLYON_SMTP_MESSAGE_ID_DOMAIN=polyon.local

# Optional encrypted secret store (takes precedence over SMTP_PASSWORD)
POLYON_SECRET_STORE_PATH=.polyon-data/secrets.json
POLYON_SECRET_MASTER_KEY_BASE64=

# Optional embedding provider (OpenAI-compatible)
POLYON_EMBEDDING_ENDPOINT=
POLYON_EMBEDDING_MODEL_ID=
POLYON_EMBEDDING_API_KEY=
POLYON_EMBEDDING_PROVIDER_ID=configured-embedding-provider
POLYON_EMBEDDING_PROVIDER_NAME=Configured embedding provider
POLYON_EMBEDDING_MODEL_NAME=
POLYON_SEMANTIC_INDEXING_AUTOSTART=true

# Optional research search provider
POLYON_RESEARCH_SEARCH_ENDPOINT=
POLYON_RESEARCH_ALLOWED_HOSTS=

# Optional private-server authentication
POLYON_API_TOKEN=

# Optional creative providers (each endpoint must be HTTPS; configure only what you use)
POLYON_CREATIVE_IMAGE_ENDPOINT=
POLYON_CREATIVE_VIDEO_ENDPOINT=
POLYON_CREATIVE_AUDIO_ENDPOINT=
POLYON_CREATIVE_VOICE_ENDPOINT=
POLYON_CREATIVE_EDIT_ENDPOINT=
