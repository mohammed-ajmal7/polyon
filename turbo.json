{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "apps/web/src/app/.well-known/workflow/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "test": {
      "dependsOn": [
        "^test"
      ]
    }
  },
  "globalEnv": [
    "POLYON_DATA_DIR",
    "POLYON_ACTOR_ID",
    "POLYON_RUNTIME_AUTOSTART",
    "POLYON_JOB_RUNTIME_AUTOSTART"
  ]
}
